      "id": "2e5c7523-4d16-4945-b06d-c52435fb48ab",
      "name": "In Hours?"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Load Config').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id !== undefined && r.id !== null);\n\nconst mins = m => m >= 60 ? `${Math.floor(m / 60)}h ${m % 60}m` : `${m}m`;\nconst wat  = iso => new Date(iso).toLocaleTimeString('en-GB', { timeZone: 'Africa/Lagos', hour: '2-digit', minute: '2-digit' });\nconst manager = cfg.staff.manager;\n\nconst out = [];\nfor (const r of rows) {\n  const level = Number(r.reminder_count) + 1;\n\n  // Level 1: the assignee. Level 2 and above: the assignee and the manager.\n  const recipients = [{ key: r.assigned_to, chat_id: cfg.staff[r.assigned_to]?.chat_id || manager.chat_id }];\n  if (level >= 2 && r.assigned_to !== 'manager') recipients.push({ key: 'manager', chat_id: manager.chat_id });\n\n  const text = [\n    `SLA REMINDER ${level} of ${cfg.max_reminders}`,\n    `Case #${r.id} (${r.category}), priority ${r.priority}`,\n    `Assigned to: ${r.assigned_to}`,\n    `Open for ${mins(Number(r.age_min))}. SLA was due at ${wat(r.sla_due_at)} WAT.`,\n    'Please claim it in Staff-Actions.'\n  ].join('\\n');\n\n  for (const rc of recipients) {\n    out.push({ json: { escalation_id: r.id, category: r.category, level, new_count: level,\n                       age_min: r.age_min, to: rc.key, chat_id: rc.chat_id, text } });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -64
      ],
      "id": "6cc57303-8499-4e06-a29a-62688b84d79d",
      "name": "Build Reminder"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Load Config').first().json;\nconst p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Lagos', weekday: 'short',\n  hour: '2-digit', hour12: false }).formatToParts(new Date());\nconst get = t => p.find(x => x.type === t).value;\nconst hour = Number(get('hour')) % 24;\nconst open = cfg.hours.days.includes(get('weekday')) && hour >= cfg.hours.open && hour < cfg.hours.close;\nreturn [{ json: { in_hours: open } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -32
      ],
      "id": "5bfbc851-0e48-4aef-993c-ac3ba37d73bb",
      "name": "Business Hours"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, category, priority, assigned_to, created_at, sla_due_at, reminder_count,\n       (EXTRACT(EPOCH FROM (now() - created_at)) / 60)::int AS age_min\nFROM escalations\nWHERE status = 'open'\n  AND sla_due_at < now()\n  AND reminder_count = 0\nORDER BY sla_due_at\nLIMIT 20;",
        "options": {}
      },
