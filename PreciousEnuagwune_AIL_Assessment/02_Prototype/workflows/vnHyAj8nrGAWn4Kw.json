      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const e   = $input.first().json;\nconst ex  = e.execution || {};\nconst wf  = e.workflow  || {};\nconst err = ex.error    || {};\n\nconst clip = (s, n) => String(s || '').replace(/\\s+/g, ' ').trim().slice(0, n);\nconst q = v => v === null || v === undefined\n  ? 'NULL'\n  : \"'\" + String(v).replace(/\\0/g, '').replace(/'/g, \"''\") + \"'\";\n\nconst workflow_name = wf.name || 'unknown workflow';\nconst failed_node   = ex.lastNodeExecuted || 'unknown node';\nconst message       = clip(err.message, 300) || 'no message';\nconst execution_id  = String(ex.id || 'unknown');\nconst when = new Date().toLocaleString('en-GB', { timeZone: 'Africa/Lagos' });\n\nconst detail = `workflow=${workflow_name}; node=${failed_node}; error=${message}`;\n\nconst alert_text = [\n  'ERROR in ' + workflow_name,\n  'Node: ' + failed_node,\n  'Message: ' + message,\n  'Time (WAT): ' + when,\n  'Execution: ' + (ex.url || execution_id)\n].join('\\n');\n\nconst sql = `INSERT INTO audit_log (request_id, phone_masked, event, detail)\nVALUES (${q(execution_id)}, NULL, 'workflow_error', ${q(detail)});`;\n\nreturn [{ json: { workflow_name, failed_node, message, execution_id, alert_text, sql } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
