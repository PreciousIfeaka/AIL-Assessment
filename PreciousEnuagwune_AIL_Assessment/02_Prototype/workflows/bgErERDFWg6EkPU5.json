      "name": "Call 'SW-Config'",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\nconst cfg = $('Call \\'SW-Config\\'').first().json\n\n// Map the category to a staff role, defaulting to sales if unmapped\nconst assigned_to = cfg.routing[$('When Executed by Another Workflow').first().json.category] || 'sales';\n\nlet targetTime = new Date();\n\n// Helper to check if a specific time is within configured business hours\nfunction isOpen(dateObj) {\n  const parts = new Intl.DateTimeFormat('en-GB', { \n    timeZone: 'Africa/Lagos', \n    weekday: 'short', \n    hour: '2-digit', \n    hour12: false \n  }).formatToParts(dateObj);\n  \n  const get = t => parts.find(x => x.type === t).value;\n  const hour = Number(get('hour')) % 24;\n  \n  return cfg.hours.days.includes(get('weekday')) && \n         hour >= cfg.hours.open && \n         hour < cfg.hours.close;\n}\n\n// If after hours, loop forward in 30-minute steps until the business opens\nwhile (!isOpen(targetTime)) {\n  targetTime.setMinutes(targetTime.getMinutes() + 30);\n}\n\n// Add the SLA minutes to the open time\ntargetTime.setMinutes(targetTime.getMinutes() + cfg.sla_minutes);\n\nreturn {\n  json: {\n    ...trigger,\n    assigned_to,\n    sla_due_at: targetTime.toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        64
      ],
      "id": "f680336b-f3ac-49ac-8b87-debda378c8ab",
      "name": "Pick Assignee and SLA"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\nconst esc = $('Insert Escalation').first().json;\nconst assigneeData = $('Pick Assignee and SLA').first().json;\n\n// Grab all messages from the Get Context node and format them\nconst messages = $('Get Context').all().map(item => item.json);\nconst chatHistory = messages.length > 0 \n  ? messages.reverse().map(m => `- ${m.text || '[' + m.msg_type + ']'}`).join('\\n')\n  : 'No previous messages.';\n  \n// Build the Telegram/Email text\nconst alertText = `🚨 *New Ticket: #${esc.id}*\n*Category:* ${trigger.category}\n*Priority:* ${trigger.priority}\n*Customer:* ${trigger.phone_masked}\n*Reason:* ${trigger.reason}\n*SLA Due:* ${new Date(assigneeData.sla_due_at).toLocaleString('en-GB', { timeZone: 'Africa/Lagos' })}\n\n*Recent Context:*\n${chatHistory}\n\n*Collected Data:*\n${trigger.context || 'None'}`;\n\nreturn [{\n  json: {\n    alert_text: alertText,\n    assigned_to: assigneeData.assigned_to,\n    ticket_id: esc.id\n  }\n}];"
      },
