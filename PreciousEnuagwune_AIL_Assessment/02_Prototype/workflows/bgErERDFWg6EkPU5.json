    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO escalations (message_id, phone_hash, category, reason, priority, assigned_to, sla_due_at, context_json)\nVALUES (\n  (SELECT id FROM messages WHERE wa_message_id = '{{ String($json.request_id).replace(/'/g, \"''\") }}'),\n  '{{ $json.phone_hash }}',\n  '{{ String($json.category).replace(/'/g, \"''\") }}',\n  '{{ String($json.reason ?? \"\").replace(/\\0/g, \"\").replace(/'/g, \"''\") }}',\n  '{{ $json.priority }}',\n  '{{ $json.assigned_to }}',\n  now() + interval '{{ Number($('Call \\'SW-Config\\'').first().json.sla_minutes) }} minutes',\n  '{{ String($json.context ?? \"{}\").replace(/\\0/g, \"\").replace(/'/g, \"''\") }}'\n)\nRETURNING id;",
