    {
      "parameters": {
        "jsCode": "const cfg  = $('Load Config').first().json;\nconst body = $('Receive').first().json.body || {};\n\nconst action = String(body.action || '').toLowerCase();\nconst id     = Number(body.id);\nconst staff  = String(body.staff || '').toLowerCase();\n\nconst errors = [];\nif (!['claim', 'resolve'].includes(action)) errors.push('action must be claim or resolve');\nif (!Number.isInteger(id) || id < 1)        errors.push('id must be a positive integer');\nif (!Object.keys(cfg.staff).includes(staff)) errors.push('unknown staff');\n\nreturn [{ json: {\n  action: errors.length ? 'invalid' : action,\n  id, staff, error: errors.join('; ')\n} }];"
      },
