    {
      "parameters": {
        "jsCode": "const m = $input.first().json;               // { phone, text } from \"Message to send\"\n\nconst phone = String(m.phone).trim();\nconst text  = String(m.text ?? '').trim();\n\n// A new ID every run. Reusing an ID makes the system ignore the message as a duplicate.\nconst waId = 'wamid.TEST.' + Date.now();\n\nconst payload = {\n  object: 'whatsapp_business_account',\n  entry: [{\n    id: '101234567890123',\n    changes: [{\n      field: 'messages',\n      value: {\n        messaging_product: 'whatsapp',\n        metadata: { display_phone_number: '2348099999999', phone_number_id: '109876543210987' },\n        contacts: [{ profile: { name: 'Test User' }, wa_id: phone }],\n        messages: [{\n          from: phone,\n          id: waId,\n          timestamp: String(Math.floor(Date.now() / 1000)),\n          type: 'text',\n          text: { body: text }\n        }]\n      }\n    }]\n  }]\n};\n\nreturn [{ json: { payload } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
