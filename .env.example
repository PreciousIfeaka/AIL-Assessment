# Database connection
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=
DB_POSTGRESDB_DATABASE=
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=

# Local access configuration
N8N_HOST=
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
N8N_WEBHOOK_URL=

# Set a static encryption key for credentials across container rebuilds
N8N_ENCRYPTION_KEY=

# Recommended memory and timezone settings
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
WA_APP_SECRET=
PHONE_PEPPER=